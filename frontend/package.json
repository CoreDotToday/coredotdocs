{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-rhwp.mjs && node scripts/rhwp-studio.mjs && node scripts/sync-genoffice.mjs && next dev",
    "build": "node scripts/copy-rhwp.mjs && node scripts/rhwp-studio.mjs && node scripts/sync-genoffice.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/sync-genoffice.mjs && vitest run",
    "typecheck": "node scripts/sync-genoffice.mjs && tsc --noEmit",
    "test:e2e": "playwright test",
    "rhwp:copy": "node scripts/copy-rhwp.mjs",
    "studio:fetch": "RHWP_STUDIO_SOURCE=mirror node scripts/rhwp-studio.mjs --force",
    "studio:build": "node scripts/rhwp-studio.mjs --force",
    "genoffice:sync": "node scripts/sync-genoffice.mjs",
    "test:genoffice": "vitest run --config vitest.genoffice.config.ts && vitest run --config vitest.truths.config.ts"
  },
  "dependencies": {
    "@rhwp/core": "0.8.7",
    "@rhwp/editor": "0.8.7",
    "@tiptap/core": "3.31.0",
    "@tiptap/extensions": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "3.10.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "canvaskit-wasm": "0.42.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.31",
    "postcss-prefix-selector": "^2.2.1",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
